pkg_pre_install() {
    return 0
}

pkg_install() {
    return 0
}

pkg_post_install() {
    /bin/mkdir -p "${SYS_QPKG_DIR}/data/bin" "${SYS_QPKG_DIR}/data/agent-data" "${SYS_QPKG_DIR}/data/logs" "${SYS_QPKG_DIR}/data/run"
    /bin/chmod 755 "${SYS_QPKG_DIR}/BeszelAgent.sh" "${SYS_QPKG_DIR}/www/api.cgi" 2>/dev/null || true
    if [ -f "${SYS_QPKG_DIR}/bin/smartctl" ]; then
        /bin/chmod 755 "${SYS_QPKG_DIR}/bin/smartctl" 2>/dev/null || true
    fi
    /sbin/setcfg "$QPKG_NAME" Status complete -f /etc/config/qpkg.conf 2>/dev/null || true
    /sbin/setcfg "$QPKG_NAME" Class null -f /etc/config/qpkg.conf 2>/dev/null || true
    /sbin/setcfg "$QPKG_NAME" Installed 1 -f /etc/config/qpkgStatus.conf 2>/dev/null || true
    /sbin/setcfg "$QPKG_NAME" Status complete -f /etc/config/qpkgStatus.conf 2>/dev/null || true
    /sbin/setcfg "$QPKG_NAME" Class null -f /etc/config/qpkgStatus.conf 2>/dev/null || true
    return 0
}

pkg_pre_remove() {
    if [ -x "${SYS_QPKG_DIR}/BeszelAgent.sh" ]; then
        "${SYS_QPKG_DIR}/BeszelAgent.sh" remove || true
    fi
    return 0
}

pkg_main_remove() {
    /bin/rm -rf "/home/httpd/cgi-bin/qpkg/BeszelAgent"
    return 0
}

pkg_post_remove() {
    return 0
}
